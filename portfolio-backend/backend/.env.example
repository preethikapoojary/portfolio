# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# Auth
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# CORS / Frontend origins (domain-agnostic — update when you attach a custom domain)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (provider-agnostic — EMAIL_PROVIDER selects the implementation)
EMAIL_PROVIDER=nodemailer
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_NOTIFY_TO=your-email@example.com

# GitHub Integration
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=ghp_xxx_read_only_public_repo_scope
