# ==============================================================================
# Environment Variables for Unified Portfolio & Admin CMS
# ==============================================================================
# Copy this file to '.env.local' for local development.

# ------------------------------------------------------------------------------
# Supabase Configuration (Database, Authentication & Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Storage bucket name for portfolio media (images, avatars, resume PDFs)
NEXT_PUBLIC_SUPABASE_BUCKET=portfolio-media

# ------------------------------------------------------------------------------
# Administrator Credentials
# ------------------------------------------------------------------------------
# Email authorized to access /admin dashboard (in addition to admin_users table)
ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# Cloudflare Turnstile (Optional Bot Protection for Contact / Testimonials)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Application Base URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
